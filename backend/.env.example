# Copy to .env and fill in. Never commit .env.
# In production these are Render environment variables.

APP_ENV=development
LOG_LEVEL=INFO

# ─── Supabase (NEW project, separate from the pay app) ───────────────
# Project Settings > API in the Supabase dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage buckets — create these in Supabase Storage and keep them PRIVATE.
# The frontend reads PDFs through signed URLs, never a public URL.
BUCKET_INVOICES=invoices
BUCKET_MIX_DESIGNS=mix-designs

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Claude API ───────────────────────────────────────────────────────
# Without this, mix design parsing and invoice extraction return 503.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000

# ─── Google Drive (Phase 1 intake, Phase 3 filing) ───────────────────
# Authenticate ONE of two ways. The service account is preferred where the
# Google org allows it; OAuth user credentials are the fallback when the org
# enforces iam.disableServiceAccountCreation. See docs/SETUP.md §4.
#
# Option 1 — service account. The whole key file, as a single line. The
# service account must then be granted access to the shared drive folders.
# GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account",...}
#
# Option 2 — OAuth user credentials. Mint with:
#   python scripts/get_google_refresh_token.py --scopes drive
# Sign in as an account that can ALREADY see the folders; no sharing step.
# The client id and secret fall back to the GMAIL_OAUTH_ ones below, so if a
# single Desktop OAuth client carries both scopes you only need the token.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# DRIVE_OAUTH_REFRESH_TOKEN=

# Folder ids, from the part of each folder's URL after /folders/
# DRIVE_FOLDER_INVOICE_UPLOADS=
# DRIVE_FOLDER_WHITE_CAP=
# DRIVE_FOLDER_BT_INVOICES=

# ─── Gmail API (Phase 2 emails; same OAuth setup as the pay app) ─────
EMAIL_FROM=noreply@ferrocretebuilders.com
EMAIL_PROVIDER=log_only
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# GMAIL_SENDER_EMAIL=
# ADMIN_ALERT_EMAIL=

# ─── Frontend URL, for deep links inside emails ──────────────────────
APP_URL=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=ferrocretebuilders.com

# Shared secret for the Claude-in-Chrome upload session and for Render cron.
# Generate with: openssl rand -hex 32
# Leaving it unset denies the agent, which is the safe default.
# AGENT_API_KEY=

# ─── Kill switch (prompt §12) ────────────────────────────────────────
# true pauses Drive polling and both scheduled email jobs without a deploy.
JOBS_PAUSED=false

# ─── Schedule and thresholds (prompt §14, §8) ────────────────────────
POLL_INTERVAL_MINUTES=15
EMAIL_TIMEZONE=America/Los_Angeles
WEEKDAYS_ONLY=true
CONFIDENCE_HIGH=0.85
CONFIDENCE_LOW=0.60
PHASE_LOOKBACK_DAYS=30
